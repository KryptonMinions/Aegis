# Copy to .env and fill in. Anything not listed here uses its default from
# app/config.py. Deployed values are set by the Cloud Run workflow, not this file.

# --- Supabase (Project Settings -> API Keys) --------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- App ----------------------------------------------------------------------
# Origin(s) the frontend runs on, for CORS. Comma-separated, no wildcards.
FRONTEND_ORIGIN=http://localhost:3000
# fixture = canned demo answers; agent = the real orchestrator.
ASK_ENGINE=agent
# Anchors relative dates ("last month") to the seeded data. Match SEED_DEMO_DATE.
ASK_REFERENCE_DATE=2026-07-14
# Role tiles sign in with no password (POST /auth/demo-login). Anyone who can
# reach the API can pick any role, so enable only where all data is synthetic.
PASSWORDLESS_LOGIN_ENABLED=true
# memory = in-process (use uvicorn --workers 1). firestore needs GCP credentials.
THREAD_STORE_BACKEND=memory

# --- LLM (Gemini via Google's OpenAI-compatible endpoint) -------------------
# Model IDs live only here. The smart model needs billing on the Google project.
LLM_PROFILE_FAST_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PROFILE_FAST_MODEL=gemini-3.5-flash-lite
LLM_PROFILE_FAST_API_KEY=
LLM_PROFILE_SMART_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PROFILE_SMART_MODEL=gemini-3.1-pro-preview
LLM_PROFILE_SMART_API_KEY=
# Optional dedicated intent profile (any OpenAI-compatible endpoint). Leave
# blank to use the fast profile.
LLM_PROFILE_INTENT_BASE_URL=
LLM_PROFILE_INTENT_MODEL=
LLM_PROFILE_INTENT_API_KEY=

# --- Sibling services ---------------------------------------------------------
# Embeddings (embeddings-service, runs on :8081 locally). The model must match
# the seeded vectors (multilingual-e5-base, 768-dim).
EMBEDDINGS_BASE_URL=http://localhost:8081
EMBEDDINGS_MODEL=intfloat/multilingual-e5-base
EMBEDDINGS_API_KEY=
# PDF export (pdf-service/). Leave false and blank unless you run it.
PDF_EXPORT_ENABLED=false
PDF_SERVICE_BASE_URL=
PDF_SERVICE_API_KEY=

# --- Voice input (Sarvam speech-to-text). Leave blank to skip. ----------------
SARVAM_API_KEY=

# --- Seeding only (scripts/seed/*, see SEED_RUNBOOK.md); the app never reads these
# Direct Postgres connection string (Supabase -> Project Settings -> Database).
# Percent-encode special characters in the password.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
SEED_DEMO_DATE=2026-07-14
# HuggingFace read token for the gated IndicTrans2 model.
HF_TOKEN=
