# Supabase project settings (Project Settings -> API Keys -> Publishable and
# secret API keys tab)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# No JWT secret needed: this project issues tokens signed with modern
# asymmetric JWT signing keys (ES256), verified against Supabase's public
# JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json (see app/security.py).

# Domain used for synthetic, never-shown login emails: {username}@SYNTHETIC_EMAIL_DOMAIN
SYNTHETIC_EMAIL_DOMAIN=ksp.internal

# Origin(s) the frontend runs on, for CORS. Comma-separated for multiple
# (e.g. local dev + a deployed Vercel frontend at once).
FRONTEND_ORIGIN=http://localhost:3000,https://your-app.vercel.app

# Sarvam AI Saaras v3 STT (voice intake, VOICE_INTAKE_STEERING.md). Backend-only
# — never exposed to the client. Distinct from any orchestrator LLM credentials.
SARVAM_API_KEY=your-sarvam-api-key

# Runtime flag: disables voice capture without a deploy. When false, the
# transcribe endpoint 404s and the frontend hides the mic button.
VOICE_INTAKE_ENABLED=true

# --- Orchestrator / agent engine (ORCHESTRATOR_STEERING.md §2.1) -------------
# fixture = the current dispatch shell (canned demo answers). agent = the real
# tool-calling orchestrator. Keep this "fixture" in any deployed environment
# until the P2 gate passes.
ASK_ENGINE=fixture
ASK_MAX_TURN_SECONDS=45
ASK_TOKEN_BUDGET=60000
ASK_TOOL_TIMEOUT_S=10
ASK_SQL_ROW_CAP=200
ASK_SQL_STATEMENT_TIMEOUT_MS=8000
ASK_THREAD_TTL_S=3600
# Per-client-IP rate limits on /ask and /ask/stream (0 disables a limit), and
# on /auth/demo-login. Counters are per-instance.
ASK_RATE_LIMIT_PER_MINUTE=10
ASK_RATE_LIMIT_PER_HOUR=100
LOGIN_RATE_LIMIT_PER_MINUTE=20
# Passwordless demo sign-in (POST /auth/demo-login): anyone who can reach the
# API can pick any role, so enable only where all data is synthetic.
PASSWORDLESS_LOGIN_ENABLED=false
# Overrides "today" for relative-date resolution. Align with SEED_DEMO_DATE.
ASK_REFERENCE_DATE=2026-07-14
# R2 R-2 prompt caching. No request-level effect on the current Gemini
# OpenAI-compat transport (implicit caching is automatic); gates cache-token
# instrumentation into ask_turn_traces. Default off (R-5).
PROMPT_CACHE_ENABLED=false
# R2 R-3 semantic answer cache (in-process, TTL). Default off (R-5).
# lookup/case_detail/pattern use the lookup TTL; geo_analytics/trend/network
# use the analytic TTL; summary/audit are never cached.
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_TTL_LOOKUP_S=1800
ANSWER_CACHE_TTL_ANALYTIC_S=300
# R2 R-4 concurrent independent tool calls. run_sql stays serialized. Default
# off (R-5); flag off = byte-identical sequential execution.
PARALLEL_TOOLS_ENABLED=false
PARALLEL_TOOLS_MAX=4

# --- LLM profiles (OpenAI-compatible; ORCHESTRATOR_STEERING.md O-9) ----------
# fast/smart via Google's OpenAI-compat base URL. Model IDs live only here.
# NOTE: gemini-2.5-flash is 404 for new API keys (Google retired it for new
# users). `pro`-class models need BILLING enabled on the Google Cloud project
# — on the free tier they 429 ("exceeded your current quota").
#
# Deliberately pinned to the -lite variants (not gemini-flash-latest, which
# resolves to the full 3.5/3.6 flash model) for cost — verify current pricing
# at ai.google.dev/pricing before assuming this is still the cheapest option.
# All three IDs below were confirmed live against /v1beta/openai/models and
# smoke-tested for tool-calling support before being pinned here.
LLM_PROFILE_FAST_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PROFILE_FAST_MODEL=gemini-3.5-flash-lite
LLM_PROFILE_FAST_API_KEY=your-gemini-api-key
LLM_PROFILE_SMART_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PROFILE_SMART_MODEL=gemini-3.1-pro-preview
LLM_PROFILE_SMART_API_KEY=your-gemini-api-key
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT_S=30

# Optional: dedicated profile for the non-tool-calling semantic-layer intent
# call (any OpenAI-compatible endpoint). Leave blank to use the fast profile.
LLM_PROFILE_INTENT_BASE_URL=
LLM_PROFILE_INTENT_MODEL=
LLM_PROFILE_INTENT_API_KEY=

# --- Embeddings — MUST match seed stage 04_embed (multilingual-e5-base, 768d)
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=intfloat/multilingual-e5-base
EMBEDDINGS_API_KEY=

# --- GCP integration (each optional) -----------------------------------------
# Thread store: memory = in-process (requires uvicorn --workers 1);
# firestore = Cloud Firestore (durable, multi-instance safe; uses application-
# default credentials, so on Cloud Run it needs the Datastore User role).
THREAD_STORE_BACKEND=memory
# Empty = infer the project from the runtime's credentials.
GCP_PROJECT_ID=
# PDF export via the Chromium pdf-service (pdf-service/).
PDF_EXPORT_ENABLED=false
PDF_SERVICE_BASE_URL=
PDF_SERVICE_API_KEY=

# --- Data seeding (SEED_RUNBOOK.md) — used only by scripts/seed/*, not the app ---

# Direct Postgres connection string for DDL, PostGIS, and bulk COPY. This is the
# "Connection string" from Supabase → Project Settings → Database (NOT the REST
# URL above). Service role; RLS is bypassed by design during seeding. Percent-encode
# any special characters (#, @, :, /, %) in the password.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Anchors all relative seeds (chargesheet deadlines, upcoming Dasara, etc.).
# Format: YYYY-MM-DD. Re-running the seeder with a new date refreshes the demo.
SEED_DEMO_DATE=2026-07-14

# HuggingFace read-scoped access token, required for IndicTrans2 (a gated
# repo) — request access at https://huggingface.co/ai4bharat/indictrans2-en-indic-1B,
# then generate a token at https://huggingface.co/settings/tokens.
HF_TOKEN=hf_your-token-here
